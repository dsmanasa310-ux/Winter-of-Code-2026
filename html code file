"Kochi":{t:"Backwater port in Kerala",r:"South",k:"c",rain:[20,25,40,120,330,700,600,400,310,330,200,50],temp:[27,28,29,29,29,27,26,26,27,27,27,27],hz:[3,2,1,1,0,0,1],tip:"Heavy monsoon can flood low areas quickly. Move valuables up and keep to higher roads."},
"Bengaluru":{t:"Plateau city and tech hub",r:"South",k:"p",rain:[3,5,10,45,110,80,110,140,180,150,60,15],temp:[22,24,27,28,27,25,24,24,24,24,22,21],hz:[2,0,0,1,2,1,0],tip:"Short, intense storms flood roads fast. Avoid underpasses and low streets."},
"Hyderabad":{t:"Deccan plateau city",r:"South",k:"d",rain:[5,8,15,25,30,95,150,160,150,85,25,5],temp:[23,26,30,33,34,29,27,26,27,26,23,21],hz:[2,0,0,3,2,1,0],tip:"Summers are hot and dry. Drink water often and plan outdoor work early."},
"Port Blair":{t:"Island in the Andaman Sea",r:"Islands",k:"c",rain:[70,30,30,60,360,480,370,380,430,280,260,140],temp:[26,26,27,28,28,27,27,27,27,27,27,26],hz:[2,2,3,1,0,3,3],tip:"Learn your route to high ground. After strong shaking, go uphill at once."}};
const NAMES=Object.keys(P),$=s=>document.querySelector(s),sum=a=>a.reduce((x,y)=>x+y,0),mx=a=>a.indexOf(Math.max(...a)),score=n=>sum(P[n].hz);
let u=0;
function scene(k,n){
 const i="g"+(++u),C={m:["#5aa9ff","#ffe3b8"],c:["#ff9d5c","#ffe7a8"],d:["#ffb74d","#fff0c9"],p:["#7cc4ff","#fff0d0"]}[k];
 const B={m:'<path d="M0 150L70 55L110 105L175 35L250 125L310 70L400 150z" fill="#5b6b9a"/><path d="M175 35l-18 24l12-4l8 10l8-10l12 4z" fill="#fff"/><path d="M0 150L90 95L160 135L270 85L400 150z" fill="#2f4a7a"/><path d="M0 160V140Q100 125 200 140T400 135V160z" fill="#1f7a4d"/>',
 c:'<path d="M0 100Q50 90 100 100T200 100T300 100T400 100V160H0z" fill="#1c9ad6"/><path d="M0 125Q50 115 100 125T200 125T300 125T400 125V160H0z" fill="#0b6fa8"/><path d="M0 145Q60 135 120 145T250 145T400 140V160H0z" fill="#f2d49b"/><path d="M330 145Q326 110 336 80M336 80q-24-4-34 10M336 80q20-10 36 2M336 80q-8-18-26-18M336 80q14-18 32-14" fill="none" stroke="#1f5d3a" stroke-width="4" stroke-linecap="round"/>',
 d:'<path d="M0 130Q80 90 170 125T330 110T400 125V160H0z" fill="#e8a64c"/><path d="M0 150Q100 120 200 148T400 138V160H0z" fill="#c9852b"/><path d="M290 135V112M290 118l-8-6M290 124l8-8" stroke="#2f6b3a" stroke-width="5" stroke-linecap="round"/>',
 p:'<path d="M20 130V80h22v50M52 130V55h28v75M90 130V92h20v50M120 130V70h26v60M160 130V100h24v30M200 130V48h18v82M228 130V85h30v45M270 130V66h22v64M300 130V96h28v34M338 130V76h24v54" fill="#3b4a7a"/><path d="M0 160V138Q100 124 200 138T400 134V160z" fill="#2b8a6e"/><path d="M0 152Q100 142 200 152T400 148" fill="none" stroke="#7fd0ff" stroke-width="5"/>'}[k];
 return `<svg viewBox="0 0 400 160" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Illustration of ${n}"><defs><linearGradient id="${i}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${C[0]}"/><stop offset="1" stop-color="${C[1]}"/></linearGradient></defs><rect width="400" height="160" fill="url(#${i})"/><circle cx="${k=="c"?90:310}" cy="${k=="p"?36:48}" r="20" fill="#fff6c9" opacity=".95"/>${B}</svg>`;
}
function chart(L){
 const W=400,H=230,l=40,rt=36,tp=14,b=26,pw=W-l-rt,ph=H-tp-b,rm=Math.max(50,Math.ceil(Math.max(...L.flatMap(x=>x.rain))/50)*50),all=L.flatMap(x=>x.temp),lo=Math.floor(Math.min(...all)/5)*5-5,hi=Math.ceil(Math.max(...all)/5)*5+5,bw=pw/12,w=(bw-6)/L.length;
 let s=`<svg class="chart" viewBox="0 0 ${W} ${H}" role="img" aria-label="Monthly rainfall bars and temperature line">`;
 for(let g=0;g<=4;g++){const y=tp+ph*g/4;s+=`<line class="gr" x1="${l}" x2="${W-rt}" y1="${y}" y2="${y}"/>`}
 s+=`<text x="2" y="${tp+4}">${rm} mm</text><text x="2" y="${tp+ph}">0</text><text x="${W-rt+4}" y="${tp+4}">${hi}°C</text><text x="${W-rt+4}" y="${tp+ph}">${lo}°C</text>`;
 MO.forEach((m,i)=>{s+=`<text x="${l+i*bw+bw/2-3}" y="${H-8}">${m[0]}</text>`;L.forEach((x,j)=>{const h=x.rain[i]/rm*ph;s+=`<rect x="${l+i*bw+3+j*w}" y="${tp+ph-h}" width="${w-1}" height="${h}" rx="2" fill="${x.c}"/>`})});
 L.forEach(x=>{const p=x.temp.map((v,i)=>[l+i*bw+bw/2,tp+ph-(v-lo)/(hi-lo)*ph]);s+=`<polyline class="t" stroke="${x.c2}" points="${p.join(" ")}"/>`+p.map(q=>`<circle cx="${q[0]}" cy="${q[1]}" r="3" fill="var(--card)" stroke="${x.c2}" stroke-width="2"/>`).join("")});
 return s+"</svg>";
}
const ser=(n,a)=>({rain:P[n].rain,temp:P[n].temp,c:a?"#3b82f6":"#f59e0b",c2:a?"#1d4ed8":"#b45309"});
const order=n=>P[n].hz.map((v,i)=>[HZ[i],v]).sort((a,b)=>b[1]-a[1]);
const pips=v=>`<div class="pips">${[1,2,3].map(k=>`<i class="pip" style="${v>=k?"background:"+["","#2f9e44","#f08c00","#e03131"][v]:""}"></i>`).join("")}<span>${LV[v]}</span></div>`;
function guide(k){const g=GUIDE[k],L=(t,c,a)=>`<div class="card gc ${c}"><h4>${t}</h4><ul>${a.map(x=>`<li>${x}</li>`).join("")}</ul></div>`;
 return `<div class="gh" style="background:linear-gradient(135deg,${HC[k]},#1b2a5e)">${svg(k)}<div><h3>${k}</h3><p>${g[0]}</p></div></div><div class="grid g3">${L("BEFORE","bef",g[1])}${L("DURING","dur",g[2])}${L("AFTER","aft",g[3])}</div>`}
function cityCard(n){const d=P[n];return `<button class="cc" data-c="${n}"><div class="pic">${scene(d.k,n)}</div><div class="cb"><span class="rg" style="background:${RC[d.r]}">${d.r}</span><h3>${n}</h3><p>${d.t}</p><div class="mini">${order(n).filter(o=>o[1]>=3).map(o=>svg(o[0],`style="background:${HC[o[0]]}"`)).join("")}</div></div></button>`}

// Tabs
const TABS=[["home","Home"],["cities","Places"],["compare","Compare"],["guide","Disaster guide"],["ready","Get ready"],["help","Help"]];
$("#tabs").innerHTML=TABS.map(t=>`<button role="tab" type="button" data-go="${t[0]}" id="t-${t[0]}">${t[1]}</button>`).join("");
function show(n){if(!TABS.some(t=>t[0]==n))n="home";TABS.forEach(t=>{$("#p-"+t[0]).classList.toggle("on",t[0]==n);$("#t-"+t[0]).setAttribute("aria-selected",t[0]==n)});scrollTo(0,0)}
function go(n){try{location.hash=n}catch(e){}show(n)}
addEventListener("hashchange",()=>show(location.hash.slice(1)));
document.addEventListener("click",e=>{const g=e.target.closest("[data-go]");if(g)return go(g.dataset.go);const c=e.target.closest("[data-c]");if(c)openCity(c.dataset.c);const h=e.target.closest("[data-h]");if(h){gz=h.dataset.h;renderGuide();go("guide")}});

// Home
$("#mon").innerHTML=MO.map((m,i)=>`<option value="${i}">${m}</option>`).join("");$("#mon").value=new Date().getMonth();
function radar(){const m=+$("#mon").value;
 const rows=NAMES.map(n=>{const d=P[n],t=[];
  if(d.rain[m]>=250&&d.hz[0]>=2)t.push(["Flood watch",HC.Flood]);
  if(d.rain[m]>=250&&d.hz[1]>=2)t.push(["Landslide watch",HC.Landslide]);
  if([3,4,5,9,10,11].includes(m)&&d.hz[2]>=2)t.push(["Cyclone season",HC.Cyclone]);
  if(d.temp[m]>=32&&d.hz[3]>=2)t.push(["Heat risk",HC.Heatwave]);
  return [n,t]}).sort((a,b)=>b[1].length-a[1].length);
 $("#rad").innerHTML=rows.map(([n,t])=>`<button data-c="${n}"><b>${n}</b> <span class="key">${P[n].r}</span><br>${t.length?t.map(x=>`<span class="tg" style="background:${x[1]}">${x[0]}</span>`).join(""):'<span class="key">Quiet month, typically</span>'}</button>`).join("")}
$("#mon").onchange=radar;radar();
$("#tiles").innerHTML=HZ.map(h=>`<button class="tile" data-h="${h}" style="background:${HC[h]}">${svg(h)}${h}</button>`).join("");

// Cities
let sel="",reg="All",hf="";
$("#hf").innerHTML='<option value="">Any hazard</option>'+HZ.map(h=>`<option>${h}</option>`).join("");
$("#rchips").innerHTML=["All",...Object.keys(RC)].map(r=>`<button class="chip" type="button" data-r="${r}">${r}</button>`).join("");
function renderCities(){
 $("#cfilters").style.display=sel?"none":"";
 document.querySelectorAll("[data-r]").forEach(c=>c.classList.toggle("on",c.dataset.r==reg));
 if(!sel){const q=$("#q").value.trim().toLowerCase(),f=hf?HZ.indexOf(hf):-1;
  const L=NAMES.filter(n=>n.toLowerCase().includes(q)&&(reg=="All"||P[n].r==reg)&&(f<0||P[n].hz[f]>=2));
  $("#cout").innerHTML=L.length?`<div class="cg">${L.map(cityCard).join("")}</div>`:'<div class="card">No places match. Try clearing a filter.</div>';return}
 const n=sel,d=P[n],w=mx(d.rain),h=mx(d.temp),top=order(n).filter(o=>o[1]>=2),col=RC[d.r];
 $("#cout").innerHTML=`<button class="chip" data-back>← All places</button>
 <div class="banner">${scene(d.k,n)}<div><span class="rg" style="background:${col}">${d.r}</span><h2>${n}</h2>${d.t}</div></div>
 <div class="stats"><div class="stat" style="background:#1c7ed6"><b>${sum(d.rain).toLocaleString("en-IN")} mm</b><span>Typical rain in a year</span></div><div class="stat" style="background:#0c8599"><b>${MO[w]}</b><span>Wettest month (${d.rain[w]} mm)</span></div><div class="stat" style="background:#e8590c"><b>${MO[h]}</b><span>Warmest month (${d.temp[h]}°C average)</span></div><div class="stat" style="background:#7048e8"><b>${Math.min(...d.temp)}°C</b><span>Coolest month average</span></div></div>
 <div class="grid g2"><div>${chart([ser(n,1)])}<p class="key">Bars: rainfall each month. Dashed line: average temperature. Rounded long-term values.</p></div>
 <div class="card"><h3>Disasters this place is prone to</h3>${order(n).map(o=>`<div class="risk">${svg(o[0],`style="background:${HC[o[0]]}"`)}<b>${o[0]}</b>${pips(o[1])}</div>`).join("")}<p class="key">A simple guide for learning, not an official hazard map.</p></div></div>
 <div class="note"><b>Top tip for ${n}.</b> ${d.tip}</div>
 <button class="btn" style="background:var(--navy);color:#fff" data-cmp="${n}">Compare ${n} with another place</button>
 <h2>What people here should do</h2>${top.map(o=>guide(o[0])+"<br>").join("")}`}
function openCity(n){sel=n;renderCities();go("cities")}
$("#q").oninput=renderCities;$("#hf").onchange=e=>{hf=e.target.value;renderCities()};
document.addEventListener("click",e=>{const r=e.target.closest("[data-r]");if(r){reg=r.dataset.r;renderCities()}if(e.target.closest("[data-back]")){sel="";renderCities();scrollTo(0,0)}const c=e.target.closest("[data-cmp]");if(c){$("#ca").value=c.dataset.cmp;if($("#cb").value==c.dataset.cmp)$("#cb").value=NAMES.find(x=>x!=c.dataset.cmp);compare();go("compare")}});

// Compare
const opts=NAMES.map(n=>`<option>${n}</option>`).join("");$("#ca").innerHTML=opts;$("#cb").innerHTML=opts;$("#ca").value="Mumbai";$("#cb").value="Jaisalmer";
function compare(){const a=$("#ca").value,b=$("#cb").value,f=n=>{const d=P[n];return [sum(d.rain).toLocaleString("en-IN")+" mm",`${MO[mx(d.rain)]} (${Math.max(...d.rain)} mm)`,`${MO[mx(d.temp)]} (${Math.max(...d.temp)}°C)`,Math.min(...d.temp)+"°C",order(n)[0][0],score(n)+" of 21"]};
 const A=f(a),B=f(b),lab=["Rain in a year","Wettest month","Warmest month","Coolest month avg","Biggest hazard","Risk score"];
 $("#cmp").innerHTML=`<div class="lg"><span><i style="background:#3b82f6"></i>${a}</span><span><i style="background:#f59e0b"></i>${b}</span></div>${chart([ser(a,1),ser(b,0)])}<p class="key">Bars: rainfall. Dashed lines: temperature.</p><table><tr><th></th><th>${a}</th><th>${b}</th></tr>${lab.map((l,i)=>`<tr><td><b>${l}</b></td><td>${A[i]}</td><td>${B[i]}</td></tr>`).join("")}</table>`}
function rank(){const m=$("#met").value,v=n=>m=="rain"?sum(P[n].rain):m=="hot"?Math.max(...P[n].temp):score(n),un=m=="rain"?" mm":m=="hot"?"°C":"/21";
 const rows=[...NAMES].sort((x,y)=>v(y)-v(x)),top=Math.max(...rows.map(v));
 $("#rank").innerHTML=rows.map(n=>`<div class="br"><span>${n}</span><div style="width:${Math.max(3,v(n)/top*100)}%;background:${RC[P[n].r]}"></div><b>${v(n).toLocaleString("en-IN")}${un}</b></div>`).join("")+`<div class="lg">${Object.entries(RC).map(([k,c])=>`<span><i style="background:${c}"></i>${k}</span>`).join("")}</div>`}
$("#ca").onchange=$("#cb").onchange=compare;$("#met").onchange=rank;compare();rank();

// Guide
let gz="Flood";
function renderGuide(){$("#gtabs").innerHTML=HZ.map(h=>`<button class="chip ${h==gz?"on":""}" type="button" data-g="${h}">${h}</button>`).join("");
 const f=HZ.indexOf(gz),L=NAMES.filter(n=>P[n].hz[f]>=2).sort((a,b)=>P[b].hz[f]-P[a].hz[f]);
 $("#gout").innerHTML=guide(gz)+`<h3 style="margin-top:20px">Places on this site most prone to ${gz.toLowerCase()}</h3><div class="row" style="margin-top:8px">${L.length?L.map(n=>`<button class="chip" data-c="${n}" style="border-color:${HC[gz]}">${n}${P[n].hz[f]==3?" ●":""}</button>`).join(""):'<span class="key">None rated medium or high.</span>'}</div><p class="key">● = high. <a href="${HS[gz][0]}" target="_blank" rel="noopener" style="color:var(--pri);font-weight:700">${HS[gz][1]}</a></p>`}
document.addEventListener("click",e=>{const g=e.target.closest("[data-g]");if(g){gz=g.dataset.g;renderGuide()}});

// Kit and plan
const KIT=["Drinking water for 3 days (about 3 litres per person per day)","Dry food that needs no cooking","Torch, spare batteries and a power bank","First-aid kit and regular medicines","ORS packets and water purification tablets","Battery or hand-crank radio","Copies of ID and important papers in a waterproof bag","Cash in small notes","Whistle to signal for help","Warm clothes and a rain poncho","Written list of emergency numbers","Charged phone with official alert apps installed"];
let ticks=[];try{ticks=JSON.parse(localStorage.getItem("ba_kit")||"[]")}catch(e){}
const save=()=>{try{localStorage.setItem("ba_kit",JSON.stringify(ticks))}catch(e){}};
function kit(){$("#kitList").innerHTML=KIT.map((k,i)=>`<li class="${ticks.includes(i)?"done":""}"><label><input type="checkbox" data-i="${i}" ${ticks.includes(i)?"checked":""}><span>${k}</span></label></li>`).join("");
 $("#prog").textContent=`${ticks.length} of ${KIT.length} packed`;$("#bar").style.width=ticks.length/KIT.length*100+"%";
 document.querySelectorAll("#kitList input").forEach(x=>x.onchange=()=>{const i=+x.dataset.i;ticks=x.checked?[...ticks,i]:ticks.filter(t=>t!==i);save();kit()})}
$("#reset").onclick=()=>{ticks=[];save();kit()};
["f1","f2","f3"].forEach(id=>{try{$("#"+id).value=localStorage.getItem("ba_"+id)||""}catch(e){}$("#"+id).oninput=e=>{try{localStorage.setItem("ba_"+id,e.target.value)}catch(x){}}});
$("#theme").onclick=()=>{const r=document.documentElement,d=r.dataset.theme?r.dataset.theme==="dark":matchMedia("(prefers-color-scheme:dark)").matches;r.dataset.theme=d?"light":"dark"};
renderCities();renderGuide();kit();show(location.hash.slice(1));
</script>
